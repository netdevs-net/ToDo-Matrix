# Port the Node server listens on.
PORT=3000

# Where the encrypted sync blob is written. Keep this outside the repo and
# outside the build context: a `git clean` in the checkout would take the blob
# with it. In Docker this is a named volume and should be left alone.
DATA_DIR=/var/lib/todo

# Shared secret every sync request must present as `Authorization: Bearer ...`.
# There are no user accounts -- this token is the only thing standing between
# the internet and your encrypted blob, so generate it rather than choosing it:
#
#   openssl rand -hex 32
#
# Leave it unset and the sync API answers 503 to everything, which is the right
# failure for a deploy that has not been configured. It is not the passphrase:
# the token gets you the ciphertext, the passphrase decrypts it, and the server
# never sees the passphrase at all.
SYNC_TOKEN=
